[1.868199, "o", "\u001b[1;16H\u001b[38;5;15;49m\"\"\u001b[38;5;8;49m  ← regex filter that defines which processes are experiments\u001b[1;135H\u001b[39;49m                                              \u001b[3;82H──────────────────────────────────────────────\u001b[4;2H\u001b[38;5;6;49m congestion (sci) \u001b[39;49m                                           \u001b[4;65H\u001b[1m\u001b[38;5;6;49mparams                                 sci    cpu%   mem%   io%    cf     util%    wait%    wall    usr    state   \u001b[5;2H↑ \u001b[38;5;15;49mcongestion (sci)\u001b[22m\u001b[38;5;8;49m — 0-100 saturating index of current s…\u001b[39;49m    \u001b[5;65H\u001b[1m\u001b[38;5;6;49m↓ \u001b[38;5;15;49mparams\u001b[22m\u001b[38;5;8;49m — command line of the experiment run\u001b[6;2H\u001b[38;5;6;49m cpu pressure \u001b[39;49m                                               \u001b[6;65H\u001b[1m\u001b[38;5;6;49m↓ \u001b[38;5;15;49msci\u001b[22m\u001b[38;5;8;49m — run congestion index (0-100): the run's psi pressures + scheduler wait, compressed into one saturating\u001b[7;2H\u001b[1m\u001b[38;5;6;49m↑ \u001b[38;5;15;49mcpu pressure\u001b[22m\u001b[38;5;8;49m — PSI cpu stalls in the last interval\u001b[39;49m         \u001b[7;65H\u001b[38;5;8;49mnumber — 0 = idle, 50 = half saturated\u001b[8;2H\u001b[38;5;6;49m mem pressure \u001b[39;49m                              \u001b[8;54H         \u001b[8;65H\u001b[1m\u001b[38;5;6;49m↓ \u001b[38;5;15;49mcpu%\u001b[22m\u001b[38;5;8;49m — share of the run's congestion caused by CPU\u001b[9;2H\u001b[1m\u001b[38;5;6;49m↑ \u001b[38;5;15;49mmem pressure\u001b[22m\u001b[38;5;8;49m — PSI memory stalls in the last interval\u001b[39;49m      \u001b[9;65H\u001b[1m\u001b[38;5;6;49m↓ \u001b[38;5;15;49mmem%\u001b[22m\u001b[38;5;8;49m — share of the run's congestion caused by memory\u001b[10;2H\u001b[38;5;6;49m io pressure \u001b[39;49m                                                \u001b[10;65H\u001b[1m\u001b[38;5;6;49m↓ \u001b[38;5;15;49mio%\u001b[22m