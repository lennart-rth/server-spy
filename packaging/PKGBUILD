# Maintainer: lennart-rth <lennart-rth@users.noreply.github.com>
# Contributor: lennart-rth <lennart-rth@users.noreply.github.com>

pkgname=server-spy
pkgver=0.1.0
pkgrel=1
pkgdesc="System congestion tracker for shared servers: watch what your experiment processes get vs what the rest of the machine consumes"
arch=('x86_64' 'aarch64')
url="https://github.com/lennart-rth/server-spy"
license=('MIT')
depends=('glibc' 'gcc-libs')
makedepends=('cargo' 'rust')
source=("$pkgname-$pkgver.crate::https://static.crates.io/crates/$pkgname/$pkgname-$pkgver.crate")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo build --release --locked --offline
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo test --release --locked --offline
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
}
